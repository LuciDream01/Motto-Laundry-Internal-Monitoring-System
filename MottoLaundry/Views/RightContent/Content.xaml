<UserControl x:Class="MottoLaundry.Views.RightContent.RightMainContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MottoLaundry.Views.RightContent"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>

        <!-- CUSTOMER RECORDS EMPTY PANEL -->
        <Border Grid.Row="2"
        Background="White"
        CornerRadius="20"
        Padding="12"
        BorderBrush="#E5E5E5"
        BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="Gray"
                          BlurRadius="4"
                          ShadowDepth="2"
                          Opacity="0.3"/>
            </Border.Effect>

            <!-- EMPTY CONTENT AREA -->
            <Grid x:Name="CustomerRecordsContent"
          Background="Transparent">

                <!-- ADD YOUR CONTROLS OR US​​ERCONTROLS HERE -->

            </Grid>

        </Border>

    </Grid>
</UserControl>
