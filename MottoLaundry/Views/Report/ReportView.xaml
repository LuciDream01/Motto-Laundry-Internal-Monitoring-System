<UserControl x:Class="MottoLaundry.Views.Report.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MottoLaundry.Views.Report"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>

        <!-- SHARED WHITE CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- METRIC VALUE STYLE -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#030164"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- METRIC TITLE STYLE -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#030164"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- CHART TITLE STYLE -->
        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#030164"/>
        </Style>

    </UserControl.Resources>

    <Grid x:Name="RightContentGrid"
          Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP ADMIN HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">

            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH BAR -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- ADMIN PROFILE -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Border Width="30"
                            Height="30"
                            Background="#030164"
                            CornerRadius="15">
                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#030164"
                               FontWeight="Bold"
                               FontSize="12"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN REPORTS AREA -->
        <Grid Grid.Row="1"
              Margin="18,20,18,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="115"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- REPORTS TITLE AND DATE -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- REPORTS TITLE CARD -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Reports"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#030164"/>

                        <TextBlock Text="Monitor key performance metrics."
                                   FontSize="15"
                                   Foreground="#030164"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DATE CARD -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Height="65"
                        VerticalAlignment="Top"
                        CornerRadius="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="▣"
                                   FontSize="24"
                                   Foreground="#030164"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Today"
                                       FontSize="11"
                                       Foreground="#030164"/>

                            <TextBlock x:Name="txtCurrentDate"
                                       FontSize="11"
                                       Foreground="#030164"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- PERFORMANCE METRICS -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- AVERAGE TURNAROUND -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Average Turnaround Time"
                                   Style="{StaticResource MetricTitleStyle}"/>

                        <TextBlock x:Name="txtAverageTurnaround"
                                   Text="60 hours"
                                   Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ON-TIME ORDERS -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="On-Time Orders"
                                   Style="{StaticResource MetricTitleStyle}"/>

                        <TextBlock x:Name="txtOnTimeOrders"
                                   Text="80 %"
                                   Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- DELAYED ORDERS -->
                <Border Grid.Column="4"
                        Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Delayed Orders"
                                   Style="{StaticResource MetricTitleStyle}"/>

                        <TextBlock x:Name="txtDelayedOrders"
                                   Text="15 %"
                                   Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- ORDERS WITH ISSUE -->
                <Border Grid.Column="6"
                        Style="{StaticResource CardStyle}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Orders with Issue"
                                   Style="{StaticResource MetricTitleStyle}"/>

                        <TextBlock x:Name="txtOrdersWithIssue"
                                   Text="5 %"
                                   Style="{StaticResource MetricValueStyle}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- CHARTS ROW 1 -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TURNAROUND TIME OVERVIEW -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Turnaround Time Overview"
                                   Style="{StaticResource ChartTitleStyle}"/>

                        <ContentControl x:Name="TurnaroundChartContent"
                                        Grid.Row="1"/>
                    </Grid>
                </Border>

                <!-- ORDER STATUS DISTRIBUTION -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order Status Distribution"
                                   Style="{StaticResource ChartTitleStyle}"/>

                        <ContentControl x:Name="OrderStatusChartContent"
                                        Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- CHARTS ROW 2 -->
            <Grid Grid.Row="3">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- TEAM PERFORMANCE -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Team Performance"
                                   Style="{StaticResource ChartTitleStyle}"/>

                        <ContentControl x:Name="TeamPerformanceContent"
                                        Grid.Row="1"/>
                    </Grid>
                </Border>

                <!-- ORDER ISSUES -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order Issues"
                                   Style="{StaticResource ChartTitleStyle}"/>

                        <ContentControl x:Name="OrderIssuesContent"
                                        Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>