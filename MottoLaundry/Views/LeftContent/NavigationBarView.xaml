<UserControl x:Class="MottoLaundry.Views.Dashboard.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MottoLaundry.Views.Dashboard"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- SIDEBAR BUTTON STYLE -->
        <Style x:Key="SidebarButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#030164"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#151394"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#2523B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SHARED WHITE CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- METRIC VALUE STYLE -->
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#030164"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- METRIC TITLE STYLE -->
        <Style x:Key="MetricTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#030164"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- CHART TITLE STYLE -->
        <Style x:Key="ChartTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#030164"/>
        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="White">

        <Grid.ColumnDefinitions>
            <!-- LEFT SIDEBAR -->
            <ColumnDefinition Width="300"/>

            <!-- RIGHT CONTENT -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================================== -->
        <!-- LEFT SIDEBAR -->
        <!-- =================================== -->

        <Grid Grid.Column="0"
              Background="#030164">

            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- LOGO AND TITLE -->
            <Grid Grid.Row="0">

                <Image Source="pack://application:,,,/Resources/Icon/MottoLaundryIcon.png"
                       Width="260"
                       Height="230"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,16,0,0"/>

                <TextBlock Text="INTERNAL MANAGEMENT"
                           Foreground="White"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>

            </Grid>

            <!-- NAVIGATION TABS -->
            <Grid Grid.Row="1"
                  Margin="0,35,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DASHBOARD -->
                <Button x:Name="BtnDashboard"
                        Grid.Row="0"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="GridDashboardIcon"
                              Grid.Column="0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Dashboard"
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- CUSTOMER RECORD -->
                <Button x:Name="BtnCustomerRecord"
                        Grid.Row="1"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="GridCustomerRecordIcon"
                              Grid.Column="0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Customer Record"
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- ORDER MONITORING -->
                <Button x:Name="BtnOrderMonitoring"
                        Grid.Row="2"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="GridOrderMonitoringIcon"
                              Grid.Column="0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Order Monitoring"
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <!-- REPORT -->
                <Button x:Name="BtnReport"
                        Grid.Row="3"
                        Style="{StaticResource SidebarButtonStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="GridReportIcon"
                              Grid.Column="0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Report"
                                   Foreground="White"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>

            </Grid>
        </Grid>

        <!-- =================================== -->
        <!-- RIGHT SIDE -->
        <!-- =================================== -->

        <Grid x:Name="RightContentGrid"
              Grid.Column="1"
              Background="White">

            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP ADMIN HEADER -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E5E5E5"
                    BorderThickness="0,0,0,1">

                <Grid Margin="15,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH BAR -->
                    <TextBox x:Name="txtSearch"
                             Grid.Column="0"
                             Height="32"
                             Margin="0,0,30,0"
                             VerticalAlignment="Center"
                             FontSize="13"
                             Padding="10,5"
                             BorderBrush="#AAAAAA"
                             BorderThickness="1"/>

                    <!-- ADMIN PROFILE -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Border Width="30"
                                Height="30"
                                Background="#030164"
                                CornerRadius="15">
                            <TextBlock Text="👤"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="ADMIN"
                                   Foreground="#030164"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN REPORTS AREA -->
            <Grid Grid.Row="1"
                  Margin="18,20,18,15">

                <Grid.RowDefinitions>
                    <RowDefinition Height="115"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- =================================== -->
                <!-- REPORTS TITLE AND DATE -->
                <!-- =================================== -->

                <Grid Grid.Row="0"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="155"/>
                    </Grid.ColumnDefinitions>

                    <!-- REPORTS TITLE CARD -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="20">

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Reports"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#030164"/>

                            <TextBlock Text="Monitor key performance metrics."
                                       FontSize="15"
                                       Foreground="#030164"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- DATE CARD -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Height="65"
                            VerticalAlignment="Top"
                            CornerRadius="10">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="▣"
                                       FontSize="24"
                                       Foreground="#030164"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Today"
                                           FontSize="11"
                                           Foreground="#030164"/>

                                <TextBlock x:Name="txtCurrentDate"
                                           FontSize="11"
                                           Foreground="#030164"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- =================================== -->
                <!-- PERFORMANCE METRICS -->
                <!-- =================================== -->

                <Grid Grid.Row="1"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- AVERAGE TURNAROUND -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Average Turnaround Time"
                                       Style="{StaticResource MetricTitleStyle}"/>

                            <TextBlock x:Name="txtAverageTurnaround"
                                       Text="60 hours"
                                       Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- ON-TIME ORDERS -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="On-Time Orders"
                                       Style="{StaticResource MetricTitleStyle}"/>

                            <TextBlock x:Name="txtOnTimeOrders"
                                       Text="80 %"
                                       Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- DELAYED ORDERS -->
                    <Border Grid.Column="4"
                            Style="{StaticResource CardStyle}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Delayed Orders"
                                       Style="{StaticResource MetricTitleStyle}"/>

                            <TextBlock x:Name="txtDelayedOrders"
                                       Text="15 %"
                                       Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- ORDERS WITH ISSUE -->
                    <Border Grid.Column="6"
                            Style="{StaticResource CardStyle}">
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="Orders with Issue"
                                       Style="{StaticResource MetricTitleStyle}"/>

                            <TextBlock x:Name="txtOrdersWithIssue"
                                       Text="5 %"
                                       Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- =================================== -->
                <!-- CHARTS ROW 1 -->
                <!-- =================================== -->

                <Grid Grid.Row="2"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TURNAROUND TIME OVERVIEW -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Turnaround Time Overview"
                                       Style="{StaticResource ChartTitleStyle}"/>

                            <ContentControl x:Name="TurnaroundChartContent"
                                            Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <!-- ORDER STATUS DISTRIBUTION -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Order Status Distribution"
                                       Style="{StaticResource ChartTitleStyle}"/>

                            <ContentControl x:Name="OrderStatusChartContent"
                                            Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- =================================== -->
                <!-- CHARTS ROW 2 -->
                <!-- =================================== -->

                <Grid Grid.Row="3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TEAM PERFORMANCE -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Team Performance"
                                       Style="{StaticResource ChartTitleStyle}"/>

                            <ContentControl x:Name="TeamPerformanceContent"
                                            Grid.Row="1"/>
                        </Grid>
                    </Border>

                    <!-- ORDER ISSUES -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Order Issues"
                                       Style="{StaticResource ChartTitleStyle}"/>

                            <ContentControl x:Name="OrderIssuesContent"
                                            Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
