<UserControl x:Class="MottoLaundry.Views.StatusMonitoring.StatusMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- ============================================== -->
        <!-- ORIGINAL STATUS MONITORING CARD STYLES -->
        <!-- ============================================== -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="5"
                                      ShadowDepth="3"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusIconStyle" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================== -->
        <!-- DASHBOARD-INSPIRED DATAGRID STYLES -->
        <!-- ============================================== -->

        <Style x:Key="OutlinedDataGridStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style x:Key="TableHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,3,4,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowOutline"
                                Background="White"
                                BorderBrush="#777777"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="1,1,1,3">

                            <Border.Effect>
                                <DropShadowEffect Color="#555555"
                                                  BlurRadius="3"
                                                  ShadowDepth="2"
                                                  Opacity="0.25"/>
                            </Border.Effect>

                            <DataGridCellsPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="Background"
                                        Value="#F1F3FF"/>
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#08065E"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#008CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#08065E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SERVICE STATUS: SAME COLOR FOR ALL STATUSES -->
        <Style x:Key="ServiceStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#DCE8FF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ServiceStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- SCHEDULE STATUS: GREEN OR RED -->
        <Style x:Key="ScheduleBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#D5F5DF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ScheduleStatus}"
                             Value="Delayed">
                    <Setter Property="Background" Value="#FFD9DC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScheduleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#239D57"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ScheduleStatus}"
                             Value="Delayed">
                    <Setter Property="Foreground" Value="#C52936"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================================== -->
        <!-- ORIGINAL UPDATE PANEL STYLES -->
        <!-- ============================================== -->

        <Style x:Key="StageComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#FCA5A5"/>
        </Style>

        <Style x:Key="EmployeeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

    </UserControl.Resources>

    <!-- ============================================== -->
    <!-- MAIN LAYOUT -->
    <!-- ============================================== -->

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="txtSearch_TextChanged"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">
                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- MAIN CONTENT -->
        <!-- ============================================== -->

        <Grid Grid.Row="1" Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="115"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE AND DATE -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Status Monitoring"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                        <TextBlock Text="Track the status of all Laundry progress."
                                   FontSize="16"
                                   Foreground="#08065E"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============================================== -->
                <!-- UPDATED CALENDAR CARD ONLY -->
                <!-- ============================================== -->

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="9"
                        Height="48"
                        VerticalAlignment="Top"
                        Padding="8">

                    <Border.Effect>
                        <DropShadowEffect Color="#444444"
                                          BlurRadius="5"
                                          ShadowDepth="4"
                                          Opacity="0.55"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- EMPTY IMAGE PLACEHOLDER -->
                        <Image x:Name="imgCalendar"
                               Source="/Resources/Icon/CalendarIcon.png"
                               Width="35"
                               Height="35"
                               Stretch="Uniform"
                               Margin="2,0,10,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Today"
                                       FontSize="10"
                                       Foreground="#08065E"/>

                            <TextBlock x:Name="txtCurrentDate"
                                       FontSize="10"
                                       Foreground="#08065E"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ============================================== -->
            <!-- SIX CLICKABLE STATUS CARDS -->
            <!-- ============================================== -->

            <UniformGrid Grid.Row="2" Columns="6">

                <!-- INTAKE -->
                <Border x:Name="cardIntake"
                        Tag="All"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Intake"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtIntakeCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View Intake"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- NOT STARTED -->
                <Border x:Name="cardNotStarted"
                        Tag="Not Started"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Not Started"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtNotStartedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View Pending"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- IN PROGRESS -->
                <Border x:Name="cardInProgress"
                        Tag="In Progress"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="In Progress"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtInProgressCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View In Progress"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- COMPLETED -->
                <Border x:Name="cardCompleted"
                        Tag="Completed"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Completed"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtCompletedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View Completed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- UNCLAIMED -->
                <Border x:Name="cardUnclaimed"
                        Tag="Unclaimed"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Unclaimed"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtUnclaimedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View Unclaimed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- DISPATCHED -->
                <Border x:Name="cardDispatched"
                        Tag="Dispatched"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Image Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>
                            <TextBlock Text="Dispatched"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtDispatchedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>
                        <TextBlock Text="View Dispatched"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ============================================== -->
            <!-- ORDER WORKSPACE -->
            <!-- ============================================== -->

            <Grid Grid.Row="4" x:Name="OrderWorkspace">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="OrdersColumn"
                                      Width="*"
                                      MinWidth="0"/>
                    <ColumnDefinition x:Name="DetailsGapColumn"
                                      Width="0"/>
                    <ColumnDefinition x:Name="DetailsColumn"
                                      Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- ============================================== -->
                <!-- REFINED ORDER DATAGRID -->
                <!-- ============================================== -->

                <Border Grid.Column="0"
                        Style="{StaticResource OutlinedDataGridStyle}"
                        Padding="7"
                        MinWidth="0">

                    <DataGrid x:Name="dgOrders"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgOrders_SelectionChanged">

                        <DataGrid.Columns>

                            <!-- TRACKING NUMBER -->
                            <DataGridTextColumn Header="Tracking #"
                                                Binding="{Binding TrackingNumber}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="90"
                                                Width="*"/>

                            <!-- CUSTOMER NAME -->
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="130"
                                                Width="1.2*"/>

                            <!-- SERVICE CODE -->
                            <DataGridTextColumn Header="Service Code"
                                                Binding="{Binding ServiceCode}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="100"
                                                Width="*"/>

                            <!-- SERVICE STATUS -->
                            <DataGridTemplateColumn Header="Service Status"
                                                    MinWidth="110"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ServiceStatusBadgeStyle}">
                                            <TextBlock Text="{Binding ServiceStatus}"
                                                       Style="{StaticResource ServiceStatusTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- PROGRESS STAGE -->
                            <DataGridTextColumn Header="Progress Stage"
                                                Binding="{Binding ProgressStage}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="110"
                                                Width="*"/>

                            <!-- TURNAROUND TIME -->
                            <DataGridTextColumn Header="Turnaround Time"
                                                Binding="{Binding TurnaroundTime, StringFormat={}{0} Hours}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="110"
                                                Width="*"/>

                            <!-- SCHEDULE STATUS -->
                            <DataGridTemplateColumn Header="Schedule Status"
                                                    MinWidth="110"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ScheduleBadgeStyle}">
                                            <TextBlock Text="{Binding ScheduleStatus}"
                                                       Style="{StaticResource ScheduleTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ============================================== -->
                <!-- ORIGINAL UPDATE STATUS PANEL -->
                <!-- UNCHANGED -->
                <!-- ============================================== -->

                <Border x:Name="UpdateStatusPanel"
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="14"
                        Visibility="Collapsed"
                        BorderBrush="#555555"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="6,6,6,12">

                            <!-- SELECTED ORDER -->
                            <Border Background="#D0D0D0"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,15">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="txtSelectedTracking"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="txtSelectedCustomer"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"/>

                                        <TextBlock x:Name="txtSelectedService"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="27"
                                            Height="27"
                                            Click="btnCloseDetails_Click"/>
                                </Grid>
                            </Border>

                            <Separator Background="#666666"
                                       Margin="0,0,0,12"/>

                            <!-- STATUS INFORMATION -->
                            <TextBlock Text="Status Information"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="4,0,0,10"/>

                            <Grid Margin="4,0,0,15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Service Status"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <TextBlock x:Name="txtServiceStatus"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>

                                <TextBlock Grid.Row="1"
                                           Text="Schedule Status"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <TextBlock x:Name="txtScheduleStatus"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="#08065E"/>
                            </Grid>

                            <!-- PROGRESS STAGES -->
                            <TextBlock Text="Progress Stage"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="4,0,0,6"/>

                            <TextBlock Text="Employee Name / ID"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Margin="0,0,4,6"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>

                                <!-- WASHING -->
                                <CheckBox x:Name="chkWashing"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Washing"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbWashing"
                                          Grid.Row="0"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtWashingEmployee"
                                         Grid.Row="0"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- DRYING -->
                                <CheckBox x:Name="chkDrying"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Drying"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbDrying"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtDryingEmployee"
                                         Grid.Row="1"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- FOLDING -->
                                <CheckBox x:Name="chkFolding"
                                          Grid.Row="2"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Folding"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbFolding"
                                          Grid.Row="2"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtFoldingEmployee"
                                         Grid.Row="2"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- PACKING -->
                                <CheckBox x:Name="chkPacking"
                                          Grid.Row="3"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="Packing"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbPacking"
                                          Grid.Row="3"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtPackingEmployee"
                                         Grid.Row="3"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>
                            </Grid>

                            <!-- UPDATE BUTTON -->
                            <Button x:Name="btnUpdateStatus"
                                    Content="Update Status"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    MinWidth="125"
                                    Height="38"
                                    Margin="0,14,0,14"
                                    Click="btnUpdateStatus_Click"/>

                            <Separator Background="#777777"
                                       Margin="0,0,0,14"/>

                            <!-- PHOTO AND DISPATCH -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnUploadPhoto"
                                        Grid.Column="0"
                                        Content="Upload Photo"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="btnUploadPhoto_Click"/>

                                <Button x:Name="btnDispatchOrder"
                                        Grid.Column="2"
                                        Content="Dispatch"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="btnDispatchOrder_Click"/>
                            </Grid>

                            <!-- NOTES -->
                            <TextBlock Text="Note:"
                                       FontSize="12"
                                       Foreground="#08065E"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtNotes"
                                     Height="115"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Padding="8"
                                     VerticalScrollBarVisibility="Auto"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
