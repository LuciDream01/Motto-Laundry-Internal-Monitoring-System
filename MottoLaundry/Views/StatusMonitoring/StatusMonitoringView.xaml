<UserControl x:Class="MottoLaundry.Views.StatusMonitoring.StatusMonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STATUS NUMBER -->
        <Style x:Key="StatusNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- STATUS TITLE -->
        <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- STATUS DESCRIPTION -->
        <Style x:Key="StatusDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- PRIMARY BUTTON -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID HEADER -->
        <Style x:Key="TableHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8E8FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- PROGRESS STATUS DROPDOWN -->
        <Style x:Key="StageComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="3,3"/>
            <Setter Property="Background" Value="#FCA5A5"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                             Value="Completed">
                    <Setter Property="Background" Value="#A7F3D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                             Value="Current">
                    <Setter Property="Background" Value="#FDBA9A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                             Value="Not Started">
                    <Setter Property="Background" Value="#FCA5A5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- EMPLOYEE INPUT -->
        <Style x:Key="EmployeeTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,3"/>
        </Style>

    </UserControl.Resources>

    <!-- ROOT -->
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH BAR -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="txtSearch_TextChanged"/>
                </Border>

                <!-- ADMIN -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="115"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE AND DATE -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE CARD -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Status Monitoring"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                        <TextBlock Text="Track the status of all Laundry progress."
                                   FontSize="16"
                                   Foreground="#08065E"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DATE -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Height="48"
                        VerticalAlignment="Top"
                        Padding="8">

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock Text="▣"
                                   FontSize="22"
                                   Foreground="#08065E"
                                   Margin="0,0,8,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Today"
                                       FontSize="10"
                                       Foreground="#08065E"/>

                            <TextBlock x:Name="txtCurrentDate"
                                       FontSize="10"
                                       Foreground="#08065E"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- STATUS CARDS -->
            <UniformGrid Grid.Row="2" Columns="6">

                <!-- INTAKE -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="Intake" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtIntakeCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View Intake" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- NOT STARTED -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="Not Started" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtNotStartedCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View Pending" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- IN PROGRESS -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="In Progress" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtInProgressCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View In Progress" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- COMPLETED -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="Completed" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtCompletedCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View Completed" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- UNCLAIMED -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="Unclaimed" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtUnclaimedCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View Unclaimed" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- DISPATCHED -->
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="8">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Width="24" Height="24" Margin="0,0,5,0"/>
                            <TextBlock Text="Dispatched" Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="txtDispatchedCount" Text="0" Style="{StaticResource StatusNumberStyle}"/>
                        <TextBlock Text="View Dispatched" Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- DYNAMIC ORDER WORKSPACE -->
            <Grid Grid.Row="4" x:Name="OrderWorkspace">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="OrdersColumn" Width="*" MinWidth="0"/>
                    <ColumnDefinition x:Name="DetailsGapColumn" Width="0"/>
                    <ColumnDefinition x:Name="DetailsColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: ORDERS DATAGRID -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="12"
                        MinWidth="0">

                    <DataGrid x:Name="dgOrders"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              RowStyle="{StaticResource TableRowStyle}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgOrders_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tracking #"
                                                  Binding="{Binding TrackingNumber}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="90"
                                                  Width="*"/>

                            <DataGridTextColumn Header="Name"
                                                  Binding="{Binding CustomerName}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="130"
                                                  Width="1.2*"/>

                            <DataGridTextColumn Header="Service Code"
                                                  Binding="{Binding ServiceCode}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="100"
                                                  Width="*"/>

                            <DataGridTextColumn Header="Service Status"
                                                  Binding="{Binding ServiceStatus}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="110"
                                                  Width="*"/>

                            <DataGridTextColumn Header="Progress Stage"
                                                  Binding="{Binding ProgressStage}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="110"
                                                  Width="*"/>

                            <DataGridTextColumn Header="Turnaround Time"
                                                  Binding="{Binding TurnaroundTime}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="110"
                                                  Width="*"/>

                            <DataGridTextColumn Header="Schedule Status"
                                                  Binding="{Binding ScheduleStatus}"
                                                  ElementStyle="{StaticResource CenteredTextStyle}"
                                                  MinWidth="110"
                                                  Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- RIGHT: ORDER UPDATE PANEL -->
                <Border x:Name="UpdateStatusPanel"
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="14"
                        Visibility="Collapsed"
                        BorderBrush="#555555"
                        BorderThickness="1">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="6,6,6,12">

                            <!-- SELECTED ORDER -->
                            <Border Background="#D0D0D0"
                                    CornerRadius="10"
                                    Padding="16"
                                    Margin="0,0,0,15">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="txtSelectedTracking"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>

                                        <TextBlock x:Name="txtSelectedCustomer"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"/>

                                        <TextBlock x:Name="txtSelectedService"
                                                   FontSize="12"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="✕"
                                            Width="27"
                                            Height="27"
                                            Click="btnCloseDetails_Click"/>
                                </Grid>
                            </Border>

                            <Separator Background="#666666"
                                       Margin="0,0,0,12"/>

                            <!-- STATUS INFORMATION -->
                            <TextBlock Text="Status Information"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Margin="4,0,0,10"/>

                            <Grid Margin="4,0,0,15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Service Status"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <TextBlock x:Name="txtServiceStatus"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>

                                <TextBlock Grid.Row="1"
                                           Text="Schedule Status"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbScheduleStatus"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Height="29"
                                          FontSize="12">

                                    <ComboBoxItem Content="On Schedule"/>
                                    <ComboBoxItem Content="Delayed"/>

                                </ComboBox>
                            </Grid>

                            <!-- PROGRESS STAGES -->
                            <TextBlock Text="Progress Stage"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="4,0,0,6"/>

                            <TextBlock Text="Employee Name / ID"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Margin="0,0,4,6"/>

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="42"/>
                                </Grid.RowDefinitions>

                                <!-- WASHING -->
                                <CheckBox x:Name="chkWashing"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="Washing"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbWashing"
                                          Grid.Row="0"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtWashingEmployee"
                                         Grid.Row="0"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- DRYING -->
                                <CheckBox x:Name="chkDrying"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Drying"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbDrying"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtDryingEmployee"
                                         Grid.Row="1"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- FOLDING -->
                                <CheckBox x:Name="chkFolding"
                                          Grid.Row="2"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="Folding"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbFolding"
                                          Grid.Row="2"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtFoldingEmployee"
                                         Grid.Row="2"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                                <!-- PACKING -->
                                <CheckBox x:Name="chkPacking"
                                          Grid.Row="3"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          IsEnabled="False"/>

                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="Packing"
                                           VerticalAlignment="Center"
                                           FontSize="12"/>

                                <ComboBox x:Name="cmbPacking"
                                          Grid.Row="3"
                                          Grid.Column="2"
                                          Style="{StaticResource StageComboStyle}"
                                          SelectionChanged="StageCombo_SelectionChanged">
                                    <ComboBoxItem Content="Not Started"/>
                                    <ComboBoxItem Content="Current"/>
                                    <ComboBoxItem Content="Completed"/>
                                </ComboBox>

                                <TextBox x:Name="txtPackingEmployee"
                                         Grid.Row="3"
                                         Grid.Column="3"
                                         Style="{StaticResource EmployeeTextBoxStyle}"/>

                            </Grid>

                            <!-- UPDATE STATUS BUTTON -->
                            <Button x:Name="btnUpdateStatus"
                                    Content="Update Status"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    MinWidth="125"
                                    Height="38"
                                    Margin="0,14,0,14"
                                    Click="btnUpdateStatus_Click"/>

                            <!-- SEPARATOR -->
                            <Separator Background="#777777"
                                       Margin="0,0,0,14"/>

                            <!-- UPLOAD PHOTO AND DISPATCH -->
                            <Grid Margin="0,0,0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnUploadPhoto"
                                        Grid.Column="0"
                                        Content="Upload Photo"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="btnUploadPhoto_Click"/>

                                <Button x:Name="btnDispatchOrder"
                                        Grid.Column="2"
                                        Content="Dispatch"
                                        Height="38"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="btnDispatchOrder_Click"/>

                            </Grid>

                            <!-- NOTES -->
                            <TextBlock Text="Note:"
                                       FontSize="12"
                                       Foreground="#08065E"
                                       Margin="0,0,0,5"/>

                            <TextBox x:Name="txtNotes"
                                     Height="115"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Padding="8"
                                     VerticalScrollBarVisibility="Auto"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</UserControl>