<UserControl x:Class="MottoLaundry.Views.CustomerRecord.CustomerRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MottoLaundry.Views.CustomerRecord"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- ADD ORDER BUTTON WITH STRONG SHADOW -->
        <Style x:Key="AddOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="10,8">
                            <Border.Effect>
                                <DropShadowEffect Color="#444444"
                                                  BlurRadius="5"
                                                  ShadowDepth="4"
                                                  Opacity="0.55"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CALENDAR CARD WITH STRONG SHADOW -->
        <Style x:Key="CalendarCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#444444"
                                      BlurRadius="5"
                                      ShadowDepth="4"
                                      Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OUTLINED DATAGRID CONTAINER -->
        <Style x:Key="OutlinedDataGridStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#777777"
                                      BlurRadius="5"
                                      ShadowDepth="3"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID HEADER -->
        <Style x:Key="CustomerHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CENTERED DATAGRID TEXT -->
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- ROUNDED DATAGRID ROWS -->
        <Style x:Key="CustomerRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,3,4,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowOutline"
                                Background="White"
                                BorderBrush="#777777"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="1,1,1,3">

                            <Border.Effect>
                                <DropShadowEffect Color="#555555"
                                                  BlurRadius="3"
                                                  ShadowDepth="2"
                                                  Opacity="0.25"/>
                            </Border.Effect>

                            <DataGridCellsPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="Background"
                                        Value="#F1F3FF"/>
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#08065E"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#008CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID CELLS -->
        <Style x:Key="CustomerCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#08065E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH BAR -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearchCustomer"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- ADMIN -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUSTOMER RECORD CONTENT -->
        <Grid Grid.Row="1"
              Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE AND ACTIONS -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- TITLE CARD -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect Color="Gray"
                                          BlurRadius="4"
                                          ShadowDepth="2"
                                          Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Customer Records"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                        <TextBlock Text="View and manage customer records."
                                   FontSize="15"
                                   Foreground="#08065E"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DATE AND ADD BUTTON -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <!-- CALENDAR CARD -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CalendarCardStyle}">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- EMPTY CALENDAR IMAGE -->
                            <Image x:Name="imgCalendar"
                                   Source="/Resources/Icon/CalendarIcon.png"
                                   Width="35"
                                   Height="35"
                                   Stretch="Uniform"
                                   Margin="2,0,10,0"/>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Today"
                                           FontSize="10"
                                           Foreground="#08065E"/>

                                <TextBlock x:Name="txtCurrentDate"
                                           FontSize="10"
                                           Foreground="#08065E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ADD NEW ORDER BUTTON -->
                    <Button x:Name="btnAddNewOrder"
                            Grid.Row="2"
                            Style="{StaticResource AddOrderButtonStyle}"
                            FontSize="12"
                            Click="btnAddNewOrder_Click">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <!-- EMPTY PLUS IMAGE -->
                            <Image x:Name="imgAddOrder"
                                   Source="/Resources/Icon/AddOrderIcon.png"
                                   Width="35"
                                   Height="35"
                                   Stretch="Uniform"
                                   Margin="0,0,8,0"/>

                            <TextBlock Text="Add New Order"
                                       FontSize="12"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- CUSTOMER RECORD DATAGRID -->
            <Border Grid.Row="2"
                    Style="{StaticResource OutlinedDataGridStyle}"
                    Padding="12">

                <DataGrid x:Name="dgCustomerRecords"
                          Background="White"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          ColumnHeaderStyle="{StaticResource CustomerHeaderStyle}"
                          CellStyle="{StaticResource CustomerCellStyle}"
                          RowStyle="{StaticResource CustomerRowStyle}"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ColumnWidth="*"
                          MinColumnWidth="20">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Tracking #"
                                            Binding="{Binding TrackingNumber}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding CustomerName}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="1.4*"/>

                        <DataGridTextColumn Header="Service Code"
                                            Binding="{Binding ServiceCode}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="Load"
                                            Binding="{Binding Load}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="0.7*"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
