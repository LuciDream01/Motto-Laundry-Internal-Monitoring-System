<UserControl x:Class="MottoLaundry.Views.CustomerRecord.CustomerRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MottoLaundry.Views.CustomerRecord"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- ADD ORDER BUTTON STYLE -->
        <Style x:Key="AddOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID HEADER STYLE -->
        <Style x:Key="CustomerHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- DATAGRID CELL STYLE -->
        <Style x:Key="CustomerCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- CENTER DATAGRID TEXT UNDER HEADERS -->
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- DATAGRID ROW STYLE -->
        <Style x:Key="CustomerRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6E6FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- RIGHT CONTENT AREA ROOT -->
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH BAR -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        HorizontalAlignment="Stretch"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearchCustomer"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- ADMIN -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- ADMIN ICON PLACEHOLDER -->
                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CUSTOMER RECORDS CONTENT -->
        <Grid Grid.Row="1"
              Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP CONTENT -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- CUSTOMER RECORDS TITLE CARD -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect Color="Gray"
                                          BlurRadius="4"
                                          ShadowDepth="2"
                                          Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Customer Records"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                        <TextBlock Text="View and manage customer records."
                                   FontSize="15"
                                   Foreground="#08065E"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DATE AND ADD BUTTON -->
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <!-- DATE CARD -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="6"
                            Padding="8">

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="3"
                                              ShadowDepth="2"
                                              Opacity="0.25"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- CALENDAR ICON PLACEHOLDER -->
                            <TextBlock Text="▣"
                                       FontSize="22"
                                       Foreground="#08065E"
                                       Margin="0,0,8,0"/>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Today"
                                           FontSize="10"
                                           Foreground="#08065E"/>

                                <!-- DATE SET THROUGH C# -->
                                <TextBlock x:Name="txtCurrentDate"
                                           FontSize="10"
                                           Foreground="#08065E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ADD NEW ORDER BUTTON -->
                    <Button x:Name="btnAddNewOrder"
                            Grid.Row="2"
                            Style="{StaticResource AddOrderButtonStyle}"
                            FontSize="12"
                            Click="btnAddNewOrder_Click">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="✚"
                                       FontSize="15"
                                       Margin="0,0,7,0"/>

                            <TextBlock Text="Add New Order"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- CUSTOMER RECORDS TABLE CONTAINER -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="20"
                    Padding="12">

                <Border.Effect>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.3"/>
                </Border.Effect>

                <!-- DATAGRID -->
                <DataGrid x:Name="dgCustomerRecords"
                          Background="White"
                          BorderThickness="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          ColumnHeaderStyle="{StaticResource CustomerHeaderStyle}"
                          CellStyle="{StaticResource CustomerCellStyle}"
                          RowStyle="{StaticResource CustomerRowStyle}"
                          RowHeaderWidth="0"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <!-- TRACKING NUMBER -->
                        <DataGridTextColumn Header="Tracking #"
                                            Binding="{Binding TrackingNumbers}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="*"/>

                        <!-- CUSTOMER NAME -->
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding CustomerName}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="1.3*"/>

                        <!-- SERVICE CODE -->
                        <DataGridTextColumn Header="Service Code"
                                            Binding="{Binding ServiceCode}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="*"/>

                        <!-- LOAD -->
                        <DataGridTextColumn Header="Load"
                                            Binding="{Binding Load}"
                                            ElementStyle="{StaticResource CenteredTextStyle}"
                                            Width="*"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>