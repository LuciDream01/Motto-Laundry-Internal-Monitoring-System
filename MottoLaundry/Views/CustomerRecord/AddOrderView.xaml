<UserControl x:Class="MottoLaundry.Views.CustomerRecord.AddOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MottoLaundry.Views.CustomerRecord"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="900">

    <UserControl.Resources>

        <!-- SAVE BUTTON STYLE -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INPUT TEXTBOX STYLE -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="BorderBrush" Value="#777777"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- FORM LABEL STYLE -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- MAIN ROOT -->
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <!-- ADMIN PROFILE -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- ADMIN ICON -->
                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>
            </Grid>
        </Border>

        <!-- CUSTOMER RECORDS CONTENT -->
        <Grid Grid.Row="1"
              Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE AND DATE -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- CUSTOMER RECORDS TITLE CARD -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20">

                    <Border.Effect>
                        <DropShadowEffect Color="Gray"
                                          BlurRadius="4"
                                          ShadowDepth="2"
                                          Opacity="0.3"/>
                    </Border.Effect>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Customer Records"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                        <TextBlock Text="View and manage customer records."
                                   FontSize="17"
                                   Foreground="#08065E"
                                   Margin="0,4,0,0"/>

                    </StackPanel>
                </Border>

                <!-- DATE CARD -->
                <Border Grid.Column="2"
                        Height="48"
                        VerticalAlignment="Top"
                        Background="White"
                        CornerRadius="6"
                        Padding="8">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="3"
                                          ShadowDepth="2"
                                          Opacity="0.25"/>
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- CALENDAR ICON -->
                        <TextBlock Text="▣"
                                   FontSize="22"
                                   Foreground="#08065E"
                                   Margin="0,0,8,0"/>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Today"
                                       FontSize="11"
                                       Foreground="#08065E"/>

                            <TextBlock x:Name="txtCurrentDate"
                                       FontSize="11"
                                       Foreground="#08065E"/>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CUSTOMER DETAILS MAIN CARD -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="20"
                    Padding="30,18">

                <Border.Effect>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.3"/>
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="65"/>
                    </Grid.RowDefinitions>

                    <!-- CUSTOMER DETAILS SECTION HEADER -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="16,6">

                        <Border.Effect>
                            <DropShadowEffect Color="Gray"
                                              BlurRadius="3"
                                              ShadowDepth="2"
                                              Opacity="0.25"/>
                        </Border.Effect>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="Customer Details"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#08065E"/>

                            <TextBlock Text="Enter Customer Information to add new order"
                                       FontSize="13"
                                       Foreground="#08065E"/>

                        </StackPanel>
                    </Border>

                    <!-- FORM INPUTS -->
                    <Grid Grid.Row="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          MaxWidth="730"
                          Margin="20,10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="500"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <!-- TRACKING NUMBER -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Tracking Number: *"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox x:Name="txtTrackingNumber"
                                 Text="{Binding TrackingNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <!-- CUSTOMER NAME -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Customer Name: *"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox x:Name="txtCustomerName"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="2"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <!-- SERVICE CODE -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Service Code: *"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox x:Name="txtServiceCode"
                                 Text="{Binding ServiceCode, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="4"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                        <!-- LOAD QUANTITY -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Load Quantity: *"
                                   Style="{StaticResource FormLabelStyle}"/>

                        <TextBox x:Name="txtLoadQuantity"
                                 Text="{Binding Load, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Row="6"
                                 Grid.Column="2"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                    </Grid>

                    <!-- SAVE BUTTON -->
                    <Button x:Name="btnSave"
                            Command="{Binding SaveCommand}"
                            Grid.Row="2"
                            Width="135"
                            Height="40"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,0,5"
                            Style="{StaticResource SaveButtonStyle}"
                            Content="Save"
                            FontSize="14"/>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
