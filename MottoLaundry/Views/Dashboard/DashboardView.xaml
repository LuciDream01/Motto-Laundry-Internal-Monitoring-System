<UserControl x:Class="MottoLaundry.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MottoLaundry.Views.Dashboard"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- CARD STYLE -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray"
                                      BlurRadius="4"
                                      ShadowDepth="2"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STATUS NUMBER STYLE -->
        <Style x:Key="StatusNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- STATUS TITLE STYLE -->
        <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- STATUS DESCRIPTION STYLE -->
        <Style x:Key="StatusDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ADD ORDER BUTTON STYLE -->
        <Style x:Key="AddOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DATAGRID HEADER STYLE -->
        <Style x:Key="TableHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
        </Style>

        <!-- INSERTED ORDER DATA TEXT ONLY (HEADERS UNCHANGED) -->
        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8E8FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DATAGRID CELL STYLE -->
        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- MAIN ROOT -->
    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH BAR -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Border>

                <!-- ADMIN PROFILE -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DASHBOARD CONTENT -->
        <Grid Grid.Row="1"
              Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="115"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- WELCOME HEADER -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <!-- WELCOME CARD -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Ready when you are, Admin!"
                                   FontSize="21"
                                   Foreground="#08065E"/>

                        <TextBlock Text="Here’s what’s happening at Motto."
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>
                    </StackPanel>
                </Border>

                <!-- DATE AND ADD ORDER -->
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <!-- DATE CARD -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardStyle}"
                            Padding="8">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="▣"
                                       FontSize="22"
                                       Foreground="#08065E"
                                       Margin="0,0,8,0"/>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Today"
                                           FontSize="10"
                                           Foreground="#08065E"/>

                                <TextBlock x:Name="txtCurrentDate"
                                           FontSize="10"
                                           Foreground="#08065E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ADD NEW ORDER BUTTON -->
                    <Button x:Name="btnAddNewOrder"
                            Grid.Row="2"
                            Style="{StaticResource AddOrderButtonStyle}"
                            FontSize="12"
                            Content="✚  Add New Order"/>
                </Grid>
            </Grid>

            <!-- STATUS CARDS -->
            <UniformGrid Grid.Row="2"
                         Columns="6">

                <!-- INTAKE -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgIntake"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Intake"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtIntakeCount"
                                   Text="15"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View Intake"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- NOT STARTED -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgNotStarted"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Not Started"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtNotStartedCount"
                                   Text="3"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View Pending"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- IN PROGRESS -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgInProgress"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="In Progress"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtInProgressCount"
                                   Text="5"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View In Progress"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- COMPLETED -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgCompleted"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Completed"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtCompletedCount"
                                   Text="2"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View Completed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- UNCLAIMED -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgUnclaimed"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Unclaimed"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtUnclaimedCount"
                                   Text="5"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View Unclaimed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>

                <!-- DISPATCHED -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgDispatched"
                                   Width="24"
                                   Height="24"
                                   Margin="0,0,5,0"
                                   Stretch="Uniform"/>

                            <TextBlock Text="Dispatched"
                                       Style="{StaticResource StatusTitleStyle}"/>
                        </StackPanel>

                        <TextBlock x:Name="txtDispatchedCount"
                                   Text="2"
                                   Style="{StaticResource StatusNumberStyle}"/>

                        <TextBlock Text="View Dispatched"
                                   Style="{StaticResource StatusDescriptionStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- BOTTOM SECTION -->
            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ORDER TABLE -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="5">

                    <DataGrid x:Name="dgOrders"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeaderWidth="0">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tracking #"
                                                Binding="{Binding TrackingNumber}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Service Code"
                                                Binding="{Binding ServiceCode}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Service Status"
                                                Binding="{Binding ServiceStatus}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Progress Stage"
                                                Binding="{Binding ProgressStage}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Turnaround Time"
                                                Binding="{Binding TurnAroundTime,
                                                          StringFormat={}{0} Hours}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>     

                            <DataGridTextColumn Header="Schedule Status"
                                                Binding="{Binding ScheduleStatus}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Width="*"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ORDER STATUS DISTRIBUTION -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order Status Distribution"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#08065E"/>

                        <!-- CHART PLACEHOLDER -->
                        <ContentControl x:Name="OrderStatusChartContent"
                                        Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
