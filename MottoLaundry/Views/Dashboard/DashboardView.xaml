<UserControl x:Class="MottoLaundry.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <UserControl.Resources>

        <!-- =============================================== -->
        <!-- GENERAL CARD STYLE -->
        <!-- =============================================== -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#777777"
                                      BlurRadius="5"
                                      ShadowDepth="3"
                                      Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OUTLINED BOTTOM PANELS -->
        <Style x:Key="OutlinedPanelStyle"
               TargetType="Border"
               BasedOn="{StaticResource CardStyle}">
            <Setter Property="BorderBrush" Value="#303030"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <!-- =============================================== -->
        <!-- STATUS CARD STYLES -->
        <!-- =============================================== -->

        <Style x:Key="StatusNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusIconStyle" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- =============================================== -->
        <!-- ADD ORDER BUTTON -->
        <!-- =============================================== -->

        <Style x:Key="AddOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#08065E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =============================================== -->
        <!-- DATAGRID HEADER -->
        <!-- =============================================== -->

        <Style x:Key="TableHeaderStyle"
               TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="White"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =============================================== -->
        <!-- DATAGRID TEXT -->
        <!-- =============================================== -->

        <Style x:Key="CenteredTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- =============================================== -->
        <!-- DATAGRID ROWS -->
        <!-- =============================================== -->

        <Style x:Key="TableRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="4,3,4,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">

                        <Border x:Name="RowOutline"
                                Background="White"
                                BorderBrush="#777777"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="1,1,1,3">

                            <Border.Effect>
                                <DropShadowEffect Color="#555555"
                                                  BlurRadius="3"
                                                  ShadowDepth="2"
                                                  Opacity="0.25"/>
                            </Border.Effect>

                            <DataGridCellsPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="Background"
                                        Value="#F1F3FF"/>
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#08065E"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowOutline"
                                        Property="BorderBrush"
                                        Value="#008CFF"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =============================================== -->
        <!-- DATAGRID CELLS -->
        <!-- =============================================== -->

        <Style x:Key="TableCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#08065E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- =============================================== -->
        <!-- SERVICE STATUS BADGE -->
        <!-- SAME COLOR FOR ALL FIVE STATUSES -->
        <!-- =============================================== -->

        <Style x:Key="ServiceStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#DCE8FF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ServiceStatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#08065E"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- =============================================== -->
        <!-- SCHEDULE STATUS BADGE -->
        <!-- =============================================== -->

        <Style x:Key="ScheduleBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#D5F5DF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ScheduleStatus}"
                             Value="Delayed">
                    <Setter Property="Background" Value="#FFD9DC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScheduleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#239D57"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding ScheduleStatus}"
                             Value="Delayed">
                    <Setter Property="Foreground" Value="#C52936"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ===================================================== -->
    <!-- MAIN LAYOUT -->
    <!-- ===================================================== -->

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- TOP HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">

            <Grid Margin="18,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- SEARCH -->
                <Border Grid.Column="0"
                        Height="32"
                        Margin="0,0,30,0"
                        Background="White"
                        BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="5">

                    <TextBox x:Name="txtSearch"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,5"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             TextChanged="txtSearch_TextChanged"/>
                </Border>

                <!-- ADMIN -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Width="27"
                            Height="27"
                            Background="#08065E"
                            CornerRadius="14"
                            Margin="0,0,6,0">

                        <TextBlock Text="♙"
                                   Foreground="White"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ADMIN"
                               Foreground="#08065E"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- DASHBOARD CONTENT -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="18,20,15,18">

            <Grid.RowDefinitions>
                <RowDefinition Height="110"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="115"/>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- WELCOME HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="155"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Ready when you are, Admin!"
                                   FontSize="21"
                                   Foreground="#08065E"/>

                        <TextBlock Text="Here’s what’s happening at Motto."
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#08065E"/>

                    </StackPanel>
                </Border>

                <!-- DATE AND ADD ORDER -->
                <Grid Grid.Column="2">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Style="{StaticResource CardStyle}"
                            Padding="8">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="▣"
                                       FontSize="22"
                                       Foreground="#08065E"
                                       Margin="0,0,8,0"/>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Today"
                                           FontSize="10"
                                           Foreground="#08065E"/>

                                <TextBlock x:Name="txtCurrentDate"
                                           FontSize="10"
                                           Foreground="#08065E"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button x:Name="btnAddNewOrder"
                            Grid.Row="2"
                            Style="{StaticResource AddOrderButtonStyle}"
                            FontSize="12"
                            Content="✚  Add New Order"/>

                </Grid>
            </Grid>

            <!-- ================================================= -->
            <!-- SIX CLICKABLE STATUS CARDS -->
            <!-- ================================================= -->

            <UniformGrid Grid.Row="2" Columns="6">

                <!-- INTAKE -->
                <Border x:Name="cardIntake"
                        Tag="All"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgIntake"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Intake"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtIntakeCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View Intake"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

                <!-- NOT STARTED -->
                <Border x:Name="cardNotStarted"
                        Tag="Not Started"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgNotStarted"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Not Started"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtNotStartedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View Pending"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

                <!-- IN PROGRESS -->
                <Border x:Name="cardInProgress"
                        Tag="In Progress"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgInProgress"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="In Progress"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtInProgressCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View In Progress"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

                <!-- COMPLETED -->
                <Border x:Name="cardCompleted"
                        Tag="Completed"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgCompleted"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Completed"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtCompletedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View Completed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

                <!-- UNCLAIMED -->
                <Border x:Name="cardUnclaimed"
                        Tag="Unclaimed"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgUnclaimed"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Unclaimed"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtUnclaimedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View Unclaimed"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

                <!-- DISPATCHED -->
                <Border x:Name="cardDispatched"
                        Tag="Dispatched"
                        Style="{StaticResource CardStyle}"
                        Margin="5"
                        Padding="8"
                        Cursor="Hand"
                        MouseLeftButtonUp="StatusCard_Click">

                    <StackPanel VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Image x:Name="imgDispatched"
                                   Style="{StaticResource StatusIconStyle}"
                                   Margin="0,0,6,0"/>

                            <TextBlock Text="Dispatched"
                                       Style="{StaticResource StatusTitleStyle}"/>

                        </StackPanel>

                        <TextBlock x:Name="txtDispatchedCount"
                                   Text="0"
                                   Style="{StaticResource StatusNumberStyle}"
                                   Margin="0,7,0,3"/>

                        <TextBlock Text="View Dispatched"
                                   Style="{StaticResource StatusDescriptionStyle}"/>

                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ================================================= -->
            <!-- BOTTOM SECTION -->
            <!-- ================================================= -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- ORDER DATAGRID -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Style="{StaticResource OutlinedPanelStyle}"
                        Padding="7">

                    <DataGrid x:Name="dgOrders"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              ColumnHeaderStyle="{StaticResource TableHeaderStyle}"
                              CellStyle="{StaticResource TableCellStyle}"
                              RowStyle="{StaticResource TableRowStyle}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeaderWidth="0"
                              SelectionMode="Single"
                              SelectionUnit="FullRow">

                        <DataGrid.Columns>

                            <!-- TRACKING NUMBER -->
                            <DataGridTextColumn Header="Tracking #"
                                                Binding="{Binding TrackingNumber}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="90"
                                                Width="*"/>

                            <!-- CUSTOMER NAME -->
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding CustomerName}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="110"
                                                Width="*"/>

                            <!-- SERVICE CODE -->
                            <DataGridTextColumn Header="Service Code"
                                                Binding="{Binding ServiceCode}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="85"
                                                Width="*"/>

                            <!-- SERVICE STATUS -->
                            <DataGridTemplateColumn Header="Service Status"
                                                    MinWidth="105"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border Style="{StaticResource ServiceStatusBadgeStyle}">

                                            <TextBlock Text="{Binding ServiceStatus}"
                                                       Style="{StaticResource ServiceStatusTextStyle}"/>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                            <!-- PROGRESS STAGE -->
                            <DataGridTextColumn Header="Progress Stage"
                                                Binding="{Binding ProgressStage}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="95"
                                                Width="*"/>

                            <!-- TURNAROUND TIME -->
                            <DataGridTextColumn Header="Turnaround Time"
                                                Binding="{Binding TurnaroundTime, StringFormat={}{0} Hours}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                MinWidth="105"
                                                Width="*"/>

                            <!-- SCHEDULE STATUS -->
                            <DataGridTemplateColumn Header="Schedule Status"
                                                    MinWidth="110"
                                                    Width="*">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Border Style="{StaticResource ScheduleBadgeStyle}">

                                            <TextBlock Text="{Binding ScheduleStatus}"
                                                       Style="{StaticResource ScheduleTextStyle}"/>

                                        </Border>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Border>

                <!-- ================================================= -->
                <!-- ORDER STATUS DISTRIBUTION -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Style="{StaticResource OutlinedPanelStyle}"
                        Padding="14">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Order Status Distribution"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#08065E"/>

                        <ContentControl x:Name="OrderStatusChartContent"
                                        Grid.Row="1"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
